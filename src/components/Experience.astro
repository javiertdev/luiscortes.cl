---
import i18n, { t } from "i18next";
import { content } from "../_data/content";
const locale = i18n.language as keyof typeof content;
---

<section id="experience" class="py-20 bg-[#0A0E27] text-[#E6E8F0] relative overflow-hidden">
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-0 left-0 w-full h-full" style="background-image: repeating-linear-gradient(90deg, #22D3EE, #22D3EE 2px, transparent 2px, transparent 20px), repeating-linear-gradient(0deg, #22D3EE, #22D3EE 2px, transparent 2px, transparent 20px);"></div>
  </div>
  <div class="container mx-auto px-4 relative z-10">
    <h2 class="text-3xl font-bold mb-15 text-center text-[#E6E8F0]">{t("experience.title")}</h2>
    <div class="max-w-4xl mx-auto space-y-8">
      {content[locale].experiences.map((experience, index) => (
        <div class={`backdrop-blur-sm bg-white/5 p-6 rounded-2xl border border-white/10 transition-all duration-300 hover:bg-white/10 hover:shadow-lg hover:shadow-[${index % 2 === 0 ? '#6366F1' : '#22D3EE'}]/50`}>
          <div class="flex items-center gap-3 mb-4">
            {experience.company.logo && <img src={experience.company.logo} alt={experience.company.name} class="w-8 h-8 rounded" />}
            <h3 class="text-xl font-semibold text-[#E6E8F0]">{experience.company.name}</h3>
          </div>
          {experience.promotions.map((promotion, pIndex) => (
            <div class="mb-6 last:mb-0">
              <div class="flex flex-col sm:flex-row justify-between items-center">
                <div class="flex flex-col sm:flex-row items-center gap-x-2">
                  {promotion.company?.logo && <img src={promotion.company.logo} alt={promotion.company.name} class="w-6 h-6 rounded" />}
                  <h4 class="text-lg font-medium text-[#E6E8F0] text-center">{promotion.role}</h4>
                  {promotion.company && <span class="text-[#64748B] text-center">({promotion.company.name})</span>}
                </div>
                <p class={`text-[${index % 2 === 0 ? '#22D3EE' : '#6366F1'}] text-center`}>
                  {promotion.period}
                </p>
              </div>
              <p class="text-[#64748B] mt-2 mb-4 text-justify">{promotion.description}</p>
              {promotion.technologies && promotion.technologies.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-4">
                  {promotion.technologies.map((tech) => (
                    <div class="flex items-center gap-1 bg-white/10 rounded-lg px-2 py-1">
                      {tech.icon && <img src={tech.icon} alt={tech.name} class="w-4 h-4" />}
                      <span class="text-xs text-[#E6E8F0]">{tech.name}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>