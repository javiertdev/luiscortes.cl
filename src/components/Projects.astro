---
import i18n, { t } from "i18next";
import { content } from "../_data/content";
import jtYxtus from "@javiert.dev/yxtus";
const locale = i18n.language as keyof typeof content;
---

<section id="projects" class="py-20 bg-[#0e1436] text-[#E6E8F0] relative overflow-hidden">
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-0 left-0 w-full h-full" style="background-image: repeating-linear-gradient(45deg, #6366F1, #6366F1 2px, transparent 2px, transparent 20px);"></div>
  </div>
  <div class="container mx-auto px-4 relative z-10">
    <h2 class="text-3xl font-bold mb-8 text-center text-[#E6E8F0]">{t("projects.title")}</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {content[locale].projects.map((project, index) => (
        <div class={`backdrop-blur-sm bg-white/5 rounded-2xl border border-white/10 transition-all duration-300 hover:bg-white/10 hover:shadow-lg hover:shadow-[${index % 2 === 0 ? '#6366F1' : '#22D3EE'}]/50 relative`}>
          <a href={project.repository} target="_blank" class="flex items-center">
            <img src={project.logo} alt={`${project.title} Logo`} class="h-24 md:h-28 rounded-sm md:rounded-tl-2xl object-cover m-2 mr-0 lg:m-0 lg:aspect-square">
            <div class="flex-1 px-3">
              <h3 class="text-xl font-semibold text-[#E6E8F0]">{project.title}</h3>
              <p class="text-[#64748B] mt-2" set:html={new jtYxtus().parse(project.description)}></p>
            </div>
          </a>
          <a href={project.link} target="_blank" class="absolute bottom-0 left-0 w-12 h-12 z-10 translate-y-4 -translate-x-2 md:-translate-x-4">
            <img src={project.icon} alt={project.title} class="w-full h-full">
          </a>
        </div>
      ))}
    </div>
    <div class="text-center mt-16">
      <a href={content[locale].contact.rrss.github} target="_blank" class="bg-white/10 backdrop-blur-md border border-white/20 text-white text-center font-bold py-4 px-8 rounded-full shadow-xl hover:bg-white/20 transition duration-300">
        {t("projects.seeMore")}
      </a>
    </div>
  </div>
</section>
</content>