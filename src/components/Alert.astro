---
// Alert.astro - Rebuilt alert component with emojis for form feedback

import type { AlertInstance } from '../interfaces/alert.interface.ts';
---

<div id="alert-overlay" class="fixed inset-0 bg-black/50 flex items-center justify-center z-10001 pointer-events-auto hidden">
  <div class="max-w-md w-11/12 max-h-[90vh] overflow-y-auto">
    <div id="alert-content" class="bg-white/25 backdrop-blur-md border-t-4 rounded-lg shadow-2xl overflow-hidden mb-4" role="dialog" aria-modal="true">
      <div class="relative flex items-center justify-center p-4 pb-0">
        <div id="alert-icon" class="text-8xl leading-none flex justify-center items-center"></div>
        <button id="alert-close" class="absolute top-0 right-0 bg-none border-none text-xl cursor-pointer text-white p-1 rounded-full transition-colors hover:bg-white/20 hidden" aria-label="Close">✕</button>
      </div>
      <div class="p-4 text-center">
        <h2 id="alert-title" class="text-xl font-semibold text-white mb-2 hidden"></h2>
        <p id="alert-message" class="text-white leading-relaxed hidden"></p>
      </div>
      <div id="alert-buttons" class="flex gap-2 justify-center px-4 pb-4 flex-wrap hidden"></div>
      <div id="alert-footer" class="px-4 py-1 text-center border-t border-gray-200 hidden">
        <small id="alert-footer-text" class="text-sm text-white"></small>
      </div>
      <div id="alert-progress" class="h-1 bg-gray-200 relative hidden">
        <div id="progress-bar" class="h-full bg-current transition-all duration-100"></div>
      </div>
    </div>
  </div>
</div>

<script>
  let currentAlert: any = null;
  let timer: any = null;

  function getDefaultEmoji(type: string): string {
    const emojiMap: { [key: string]: string } = {
      success: '😊',
      info: 'ℹ️',
      warning: '⚠️',
      error: '😢',
      neutral: '😐'
    };
    return emojiMap[type] || 'ℹ️';
  }

  function showAlert(alert: any) {
    currentAlert = alert;
    const overlay = document.getElementById('alert-overlay')!;
    const content = document.getElementById('alert-content')!;
    const icon = document.getElementById('alert-icon')!;
    const title = document.getElementById('alert-title')!;
    const message = document.getElementById('alert-message')!;
    const buttons = document.getElementById('alert-buttons')!;
    const footer = document.getElementById('alert-footer')!;
    const footerText = document.getElementById('alert-footer-text')!;
    const progress = document.getElementById('alert-progress')!;
    const progressBar = document.getElementById('progress-bar')!;
    const closeBtn = document.getElementById('alert-close')!;

    // Set emoji
    icon.textContent = alert.emoji || getDefaultEmoji(alert.type);

    // Set border and text color based on type
    let borderColor = 'border-gray-500';
    let textColor = 'text-gray-500';
    if (alert.type === 'success') {
      borderColor = 'border-green-500';
      textColor = 'text-green-500';
    } else if (alert.type === 'error') {
      borderColor = 'border-red-500';
      textColor = 'text-red-500';
    } else if (alert.type === 'warning') {
      borderColor = 'border-yellow-500';
      textColor = 'text-yellow-500';
    } else if (alert.type === 'info') {
      borderColor = 'border-blue-500';
      textColor = 'text-blue-500';
    }

    content.className = `bg-white/25 backdrop-blur-md border-t-4 ${borderColor} rounded-lg shadow-2xl overflow-hidden mb-4`;

    // Title
    if (alert.title) {
      title.textContent = alert.title;
      title.classList.remove('hidden');
    } else {
      title.classList.add('hidden');
    }

    // Message
    if (alert.message) {
      message.textContent = alert.message;
      message.classList.remove('hidden');
    } else {
      message.classList.add('hidden');
    }

    // Buttons
    if (alert.buttons && alert.buttons.length > 0) {
      buttons.innerHTML = '';
      alert.buttons.forEach((btn: any) => {
        const button = document.createElement('button');
        let btnClass = 'px-4 py-2 border-none rounded cursor-pointer text-sm backdrop-blur-sm ';
        if (btn.type === 'primary') btnClass += 'bg-white/25 text-white border border-white/50';
        else if (btn.type === 'secondary') btnClass += 'bg-white/25 text-white border border-white/50';
        else if (btn.type === 'outline') btnClass += 'bg-transparent border border-white text-white';
        else btnClass += 'bg-transparent text-white';
        if (alert.buttons.length === 1) btnClass += ' w-full';
        button.className = btnClass;
        button.textContent = btn.text;
        button.onclick = () => {
          alert.resolve(btn.id);
          hideAlert();
        };
        buttons.appendChild(button);
      });
      buttons.classList.remove('hidden');
    } else {
      buttons.classList.add('hidden');
    }

    // Footer
    if (alert.footer) {
      footerText.textContent = alert.footer;
      footer.classList.remove('hidden');
    } else {
      footer.classList.add('hidden');
    }

    // Close button
    if (alert.showClose) {
      closeBtn.classList.remove('hidden');
      closeBtn.onclick = () => {
        alert.reject('closed');
        hideAlert();
      };
    } else {
      closeBtn.classList.add('hidden');
    }

    // Progress
    if (alert.duration && alert.duration > 0) {
      progress.classList.remove('hidden');
      startTimer(alert);
    } else {
      progress.classList.add('hidden');
    }

    overlay.classList.remove('hidden');
  }

  function hideAlert() {
    const overlay = document.getElementById('alert-overlay')!;
    overlay.classList.add('hidden');
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
    currentAlert = null;
  }

  function startTimer(alert: any) {
    alert.remainingTime = alert.duration;
    timer = setInterval(() => {
      if (alert.isPaused) return;
      alert.remainingTime -= 0.1;
      const progressBar = document.getElementById('progress-bar')!;
      const progress = (alert.remainingTime / alert.duration) * 100;
      progressBar.style.width = `${progress}%`;
      if (alert.remainingTime <= 0) {
        hideAlert();
      }
    }, 100);
  }

  // Expose globally
  (window as any).showAlert = showAlert;
  (window as any).hideAlert = hideAlert;
</script>