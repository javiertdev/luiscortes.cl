---
import i18n, { t } from "i18next";
import { content } from "../_data/content";
import jtYxtus from "@javiert.dev/yxtus";
const locale = i18n.language as keyof typeof content;
---

<section id="about" class="py-20 bg-[#0A0E27] text-[#E6E8F0] relative overflow-hidden">
    <div class="absolute inset-0 opacity-8"><div class="absolute top-0 left-0 w-full h-full" style="background-image: radial-gradient(circle at 25% 25%, #6366F1 2px, transparent 2px), radial-gradient(circle at 75% 75%, #22D3EE 2px, transparent 2px); background-size: 50px 50px;"></div>
    
  </div>
  <div class="container mx-auto px-4 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div class="relative flex justify-center">
        <div class="absolute -bottom-4 right-25 w-full max-w-sm h-full bg-black/25 rounded-2xl" style="transform: rotate(2deg)"></div>
        <img src={content[locale].aboutme.image} alt="Profile" class="relative rounded-2xl w-full max-w-sm" style="transform: rotate(-1deg); pointer-events: none" />
      </div>
      <div class="backdrop-blur-sm bg-white/5 rounded-2xl p-8 border border-white/10 transition-all duration-300 hover:bg-white/10 hover:shadow-lg hover:shadow-[#22D3EE]/50">
        <h2 class="text-3xl font-bold mb-8 text-center text-[#E6E8F0]">{t("about.title")}</h2>
        <div class="text-lg text-[#92abcf] text-justify" set:html={new jtYxtus().parse(content[locale].aboutme.description)}></div>
      </div>
    </div>
  </div>
</section>