---
import i18n, { t } from "i18next";
import { content } from "../_data/content";
const locale = i18n.language as keyof typeof content;
---

<section id="hero" class="min-h-screen flex items-center justify-center bg-linear-to-br from-[#0A0E27] via-[#0F1419] to-[#131829] text-[#E6E8F0] relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-10 left-10 w-32 h-32 bg-[#6366F1] rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-40 h-40 bg-[#22D3EE] rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-[#6366F1] rounded-full blur-3xl opacity-50"></div>
  </div>
  <div class="pulse-light absolute inset-0 z-5" style="background: radial-gradient(ellipse at bottom center, rgba(17, 255, 57, 0.2) 0%, rgba(17, 255, 57, 0.05) 30%, transparent 70%); transform: scale(1); transform-origin: bottom center;"></div>
  <canvas id="particles" class="absolute inset-0 pointer-events-none"></canvas>
  <div class="text-center relative z-10">
    <h1 class="text-8xl font-bold mb-4 text-[#E6E8F0]">{content[locale].aboutme.name}</h1>
    <p class="text-4xl text-[#64748B]">{content[locale].aboutme.role}</p>
  </div>
  <div class="absolute bottom-1/6 left-1/2 transform -translate-x-1/2 flex flex-col md:flex-row space-y-4 md:space-y-0 space-x-0 md:space-x-6 z-20">
    <a id="contact-btn" href="/es/contacto" class="bg-white/10 backdrop-blur-md border border-white/20 text-white text-center font-bold py-4 px-8 rounded-full shadow-xl hover:bg-white/20 transition duration-300">
      {t("hero.contact")}
    </a>
  </div>
</section>

<style>
.pulse-light {
  animation: pulse-light 30s infinite;
}
@keyframes pulse-light {
  0% { transform: scale(1); }
  5% { transform: scale(1.2); }
  8% { transform: scale(1); }
  11% { transform: scale(0.8); }
  17% { transform: scale(1); }
  22% { transform: scale(0.8); }
  28% { transform: scale(1); }
  34% { transform: scale(1.2); }
  40% { transform: scale(1); }
  48% { transform: scale(1.2); }
  51% { transform: scale(0.8); }
  57% { transform: scale(1); }
  62% { transform: scale(1.2); }
  68% { transform: scale(1); }
  74% { transform: scale(0.8); }
  80% { transform: scale(1); }
  88% { transform: scale(0.8); }
  91% { transform: scale(1.2); }
  100% { transform: scale(1); }
}
</style>

{/* @ts-ignore */}
<script is:inline client:load>
  const canvas = document.getElementById('particles');
  const ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

  let particles = [];

  class Particle {
    constructor() {
      this.x = Math.random() * canvas.width;
      this.y = canvas.height;
      this.speed = Math.random() * 1.5 + 0.5; // 0.5 to 2
      this.opacity = 0;
      this.maxOpacity = Math.random() * 0.5 + 0.2;
      this.blur = Math.random() * 2 + 1;
    }

    update() {
      this.y -= this.speed;
      // Opacity: increases to max at middle, then decreases
      const progress = 1 - (this.y / canvas.height);
      if (progress < 0.5) {
        this.opacity = (progress / 0.5) * this.maxOpacity;
      } else {
        this.opacity = ((1 - progress) / 0.5) * this.maxOpacity;
      }
      if (this.y < 0) {
        this.reset();
      }
    }

    reset() {
      this.x = Math.random() * canvas.width;
      this.y = canvas.height;
      this.speed = Math.random() * 1.5 + 0.5;
      this.maxOpacity = Math.random() * 0.5 + 0.2;
      this.blur = Math.random() * 2 + 1;
    }

    draw() {
      ctx.save();
      ctx.globalAlpha = this.opacity;
      ctx.filter = `blur(${this.blur}px)`;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(this.x, this.y, 2, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
  }

  for (let i = 0; i < 50; i++) {
    particles.push(new Particle());
  }

  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach(p => {
      p.update();
      p.draw();
    });
    requestAnimationFrame(animate);
  }

  animate();

  window.addEventListener('resize', () => {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  });

  // Smooth scroll to contact section
  document.getElementById('contact-btn').addEventListener('click', function(e) {
    e.preventDefault();
    const target = document.getElementById('contact');
    if (target) {
      const targetPosition = target.getBoundingClientRect().top + window.pageYOffset;
      const startPosition = window.pageYOffset;
      const distance = targetPosition - startPosition;
      const duration = 2000;
      let start = null;

      function step(timestamp) {
        if (!start) start = timestamp;
        const progress = timestamp - start;
        const percentage = Math.min(progress / duration, 1);
        const easeInOutQuad = percentage < 0.5 ? 2 * percentage * percentage : 1 - Math.pow(-2 * percentage + 2, 2) / 2;
        window.scrollTo(0, startPosition + distance * easeInOutQuad);
        if (progress < duration) {
          requestAnimationFrame(step);
        }
      }

      requestAnimationFrame(step);
    }
  });

  const locale = window.location.pathname.split('/')[1] || 'es';
  const contactHref = locale === 'es' ? '/es/contacto' : '/en/contact';
  document.getElementById('contact-btn').href = contactHref;
</script>